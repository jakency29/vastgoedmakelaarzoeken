# Alle formulieren worden client-side via Web3Forms verstuurd.
# De publieke access key mag in de browser beschikbaar zijn, maar beperk en controleer
# het gekoppelde formulier in het Web3Forms-dashboard.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Domeinmigratie. Laat deze waarden vóór de omschakeling leeg zodat .be actief blijft.
# Zet ze bij de .com-release alle drie samen en koppel zowel .be als .com aan dezelfde deployment.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
MIGRATION_TARGET_HOST=

# De Resend-variabelen hieronder zijn optioneel en alleen nodig wanneer een eigen
# server-side mailroute opnieuw wordt ingevoerd.

# API-sleutel van https://resend.com
RESEND_API_KEY=

# Adres waar leads binnenkomen (de eigenaar / makelaarsverdeler)
LEAD_TO_EMAIL=

# Afzender. Moet een geverifieerd domein in Resend zijn, bijv. leads@vastgoedmakelaarzoeken.be
LEAD_FROM_EMAIL=

# Google reviews op de kantoorpagina's: Google Places API-sleutel (server-side).
# Een sleutel volstaat voor alle kantoren; de Place ID's staan per kantoor in src/lib/kantoren.ts.
# Zonder sleutel worden de reviews netjes verborgen.
GOOGLE_PLACES_API_KEY=

# Kantoorvermeldingen: lokale SMTP- en IMAP-mailbox.
# Bewaar het echte wachtwoord uitsluitend in .env.office.local.
OFFICE_MAIL_USER=info@vastgoedmakelaarzoeken.com
OFFICE_MAIL_PASSWORD=
OFFICE_MAIL_SMTP_HOST=smtp-auth.mailprotect.be
OFFICE_MAIL_SMTP_PORT=587
OFFICE_MAIL_IMAP_HOST=imap.mailprotect.be
OFFICE_MAIL_IMAP_PORT=993
OFFICE_MAIL_FROM_NAME=Vastgoedmakelaarzoeken
